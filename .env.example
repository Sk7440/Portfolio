# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.
# The assistant runs on Ollama. Locally it talks to your Ollama app at http://localhost:11434.
# Optional: defaults to gemma4:31b-cloud.
OLLAMA_MODEL=
# Needed on Vercel (no local Ollama there): an ollama.com API key, so requests go to Ollama's cloud API.
OLLAMA_API_KEY=
# Optional: override the Ollama server URL.
OLLAMA_HOST=
